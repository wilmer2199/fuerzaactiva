<div class="background-register">
    <div class="container p-4">
        <div class="row my-4">
            <div class="col-md-4 align-items-stretch mx-auto">
                <div class="card shadow">
                    <div class="card-header bg-success text-white">
                        <h3 class="card-title my-2 text-center">Registro de Solicitud</h3>
                    </div>
                    <div class="card-body">
                        <p class="h5 text-center my-1 mr-4 mb-2 p-2 justify-content-center align-items-center">!Corrige tu solicitud¡</p>
                        <hr class="my-2">
                        <form id="solicitudEditForm" action="/links1/edit1/id/{{registro_solicitud.id}}" method="post">

                            <div class="form-group row">
                                <div class="col-md-12 mb-2">
                                    <strong>N° de Solicitud:</strong>
                                    <input type="text" value="{{registro_solicitud.numero_registro}}" class="form-control form-control-sm" id="numero_registro" name="numero_registro" placeholder="Solicitud numero 1..." autofocus required>
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-12 mb-2">
                                    <strong>Nombres y Apellidos:</strong>
                                    <input type="text" value="{{registro_solicitud.nombre_cliente}}" class="form-control form-control-sm" id="nombre_cliente" name="nombre_cliente" placeholder="Wilmer Antonio Perez Rojas" required>
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-12 mb-2">
                                    <strong>Servicio:</strong>
                                    <input type="text" value="{{registro_solicitud.tipo_servicio}}" class="form-control form-control-sm" id="tipo_servicio" name="tipo_servicio" placeholder="Vigilancia Privada" required>
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-12 mb-2">
                                    <strong class="my-1 mr-2 mb-0"> Fecha de Solicitud:</strong>
                                    <input type="date" value="{{formatDate registro_solicitud.fecha_solicitud 'YYYY-MM-DD'}}" class="form-control form-control-sm" name="fecha_solicitud" id="fecha_solicitud" required>
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-12 mb-2">
                                    <strong class="my-1 mr-4 mb-0"> Fecha Requerida </strong>
                                    <input type="date" value="{{formatDate registro_solicitud.fecha_requerida 'YYYY-MM-DD'}}" class="form-control form-control-sm" name="fecha_requerida" id="fecha_requerida" required>
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-12 mb-2">
                                    <strong>Oficiales Requeridos (Cantidad/Sexo):</strong>
                                    <input type="text" value="{{registro_solicitud.numeros_oficiales_requeridos}}" class="form-control form-control-sm" id="numero_oficiales_requeridos" name="numero_oficiales_requeridos" placeholder="20 oficiales mujer, 10 hombre...." required>
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-12 mb-2">
                                    <strong>Oficiales Requeridos (Edad):</strong>
                                    <input type="text" value="{{registro_solicitud.edad_oficiales_requeridos}}" class="form-control form-control-sm" id="edad_oficiales_requeridos" name="edad_oficiales_requeridos" placeholder="Entre 20 y 40 años" required>
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-12 mb-2">
                                    <strong>Horas Requeridas:</strong>
                                    <input type="text" value="{{registro_solicitud.duracion_estimada_horas}}" class="form-control form-control-sm" id="duracion_estimada_horas" name="duracion_estimada_horas" placeholder="12horas / 24horas..." required>
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-12 mb-2">
                                    <strong>Dirección:</strong>
                                    <textarea name="direccion_servicio" id="direccion_servicio" rows="2" class="form-control form-control-sm" placeholder="Dirección" required>{{registro_solicitud.direccion_servicio}}</textarea>
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-12 mb-2">
                                    <strong>Detalles Adicionales:</strong>
                                    <input type="text" value="{{registro_solicitud.detalles_adicionales}}" class="form-control form-control-sm" name="detalles_adicionales" placeholder="Oficiales con experencia, etc.. ">
                                </div>
                            </div>

                            <div class="form-group row">
                                <div class="col-md-12 mb-2">
                                    <strong>Descripción:</strong>
                                    <textarea name="descripcion" rows="2" class="form-control form-control-sm" placeholder="!Estoy interesa en el servicio¡, etc..">{{registro_solicitud.descripcion}}</textarea>
                                </div>
                            </div>

                            <div class="form-group row">
                                <button type="submit" class=" btn btn-outline-success btn-block col-md-12">
                                    Guardar
                                </button>
                            </div>

                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Seleccionamos el formulario por su nuevo ID
        const form = document.getElementById('solicitudEditForm');

        form.addEventListener('submit', function(event) {
            // Definimos los campos obligatorios y sus nombres para el mensaje
            const camposObligatorios = {
                numero_registro: 'N° de Solicitud',
                nombre_cliente: 'Nombres y Apellidos',
                tipo_servicio: 'Servicio',
                fecha_solicitud: 'Fecha de Solicitud',
                fecha_requerida: 'Fecha Requerida',
                numero_oficiales_requeridos: 'Oficiales Requeridos (Cantidad/Sexo)',
                edad_oficiales_requeridos: 'Oficiales Requeridos (Edad)',
                duracion_estimada_horas: 'Horas Requeridas',
                direccion_servicio: 'Dirección'
            };

            let campoVacioEncontrado = false;
            let campoFaltante = '';

            for (const id in camposObligatorios) {
                const input = document.getElementById(id);

                if (input && input.value.trim() === '') {
                    campoVacioEncontrado = true;
                    campoFaltante = camposObligatorios[id];
                    input.focus();
                    break;
                }
            }

            if (campoVacioEncontrado) {
                event.preventDefault();
                alert('Falta completar el campo: ' + campoFaltante);
            }
        });
    });
</script>