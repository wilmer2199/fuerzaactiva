<div class="background-register">
    <div class="container p-4">
        <div class="row my-4">
            <div class="col-md-4 align-items-stretch mx-auto">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h3 class="card-title my-2 text-center">Registro de Cliente</h3>
                    </div>
                    <div class="card-body">
                        <p class="h5 text-center my-1 mr-4 mb-2 p-2 justify-content-center align-items-center">!Ingresa tus datos¡</p>
                        <hr class="my-2">
                        <form id="registroForm" action="/links/add" method="post">
                            <div class="form-group row">
                                <div class="col-md-12 mb-2">
                                    <strong>N° de Registro:</strong>
                                    <input type="text" class="form-control form-control-sm" id="numero_registro" name="numero_registro" placeholder="Registro numero 1..." autofocus required>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-12 mb-2">
                                    <strong>C. (Particular/Empresa):</strong>
                                    <input type="text" class="form-control form-control-sm" id="tipo_cliente" name="tipo_cliente" placeholder="Cliente Particular o Empresa" required>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-12 mb-2">
                                    <strong>Nombres y Apellidos:</strong>
                                    <input type="text" class="form-control form-control-sm" id="nombre_contacto" name="nombre_contacto" placeholder="Wilmer Antonio Perez Rojas" required>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-12 mb-2">
                                    <strong>Empresa (Nombre)::</strong>
                                    <input type="text" class="form-control form-control-sm" name="nombre_empresa" placeholder="Empresa C.A.">
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-12 mb-2">
                                    <strong>Cédula/Rif:</strong>
                                    <input type="text" class="form-control form-control-sm" id="cedula_rif" name="cedula_rif" placeholder=" V-26.821.179 Ó j-41043916-5" required>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-12 mb-2">
                                    <strong> Correo:</strong>
                                    <input type="email" class="form-control form-control-sm" id="email_contacto" name="email_contacto" placeholder="123@gmail.com" required>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-12 mb-2">
                                    <strong> Telefono:</strong>
                                    <input type="text" class="form-control form-control-sm" id="telefono_contacto" name="telefono_contacto" placeholder="+58414-9513574" required>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-12 mb-2">
                                    <strong> Dirección:</strong>
                                    <textarea name="direccion_principal" id="direccion_principal" rows="2" class="form-control form-control-sm" placeholder="Maturin. Zona-Industrial " required></textarea>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-12 mb-2">
                                    <strong> ¿Cómo nos Conoció?:</strong>
                                    <input type="text" class="form-control form-control-sm" name="origen_cliente" placeholder="Instagram, WhatsApp">
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-12 mb-2">
                                    <strong> Descripción:</strong>
                                    <textarea name="descripcion" rows="2" class="form-control form-control-sm" placeholder="!Estoy interesado en el servicio. etc...¡ "></textarea>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-12 mb-2">
                                    <strong class="my-1 mr-4 mb-0"> Fecha de Registro</strong>
                                    <input type="date" class="form-control form-control-sm" id="fecha_registro" name="fecha_registro" placeholder="Fecha Registro " required>
                                </div>
                            </div>
                            <div class="form-group row">
                                <button type="submit" class=" btn btn-outline-primary btn-block col-md-12">
                                    Guardar
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // --- Script de validación de campos ---
        const form = document.getElementById('registroForm');

        form.addEventListener('submit', function(event) {
            // Campos obligatorios con sus nombres de campo
            const camposObligatorios = {
                numero_registro: 'N° de Registro',
                tipo_cliente: 'Tipo de Cliente (Particular/Empresa)',
                nombre_contacto: 'Nombres y Apellidos',
                cedula_rif: 'Cédula/Rif',
                email_contacto: 'Correo',
                telefono_contacto: 'Teléfono',
                direccion_principal: 'Dirección',
                fecha_registro: 'Fecha de Registro'
            };

            let campoVacioEncontrado = false;
            let campoFaltante = '';

            for (const id in camposObligatorios) {
                const input = document.getElementById(id);
                // Usamos .trim() para quitar espacios en blanco al inicio y final
                if (!input.value.trim()) {
                    campoVacioEncontrado = true;
                    campoFaltante = camposObligatorios[id];
                    // Enfoca el campo para que el usuario sepa dónde debe escribir
                    input.focus(); 
                    break; // Salimos del bucle al encontrar el primer campo vacío
                }
            }

            if (campoVacioEncontrado) {
                // Previene que el formulario se envíe
                event.preventDefault(); 
                // Muestra el mensaje de alerta
                alert('Falta completar el campo: ' + campoFaltante);
            }
        });
        
        // --- Script para mostrar/ocultar contraseña (ya lo tenías, lo dejo aquí) ---
        const passwordInput = document.getElementById('contrasena');
        const togglePasswordButton = document.getElementById('togglePassword');

        function togglePasswordVisibility(inputElement, toggleButton) {
            const type = inputElement.getAttribute('type') === 'password' ? 'text' : 'password';
            inputElement.setAttribute('type', type);

            const icon = toggleButton.querySelector('i');
            if (icon) {
                icon.classList.toggle('bi-eye-fill');
                icon.classList.toggle('bi-eye-slash-fill');
            }
        }

        if (togglePasswordButton && passwordInput) {
            togglePasswordButton.addEventListener('click', function() {
                togglePasswordVisibility(passwordInput, this);
            });
        }
    });
</script>